# Aplicação Go
PORT=3000
DATABASE_URL=postgres://finassist:finassist@localhost:5432/finassist?sslmode=disable
GEMINI_API_KEY=sua-chave-aqui
ADMIN_SECRET=troque-por-uma-senha-forte

# Canal de conversa: whatsapp (padrão) ou telegram
CHANNEL=whatsapp

# Quais containers o Docker Compose sobe: "whatsapp" inclui Evolution API + Redis.
# Para Telegram deixe vazio (COMPOSE_PROFILES=).
COMPOSE_PROFILES=whatsapp

# --- CHANNEL=whatsapp ---
ALLOWED_NUMBERS=12345678912345
EVOLUTION_API_KEY=sua-chave-evolution-aqui
EVOLUTION_API_URL=http://localhost:8082
EVOLUTION_INSTANCE=Financial Assistant
OWNER_PHONE=5511999999999

# --- CHANNEL=telegram ---
# Token criado no @BotFather e o seu ID numérico (descubra no @userinfobot).
# Só o usuário com esse ID é atendido.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Open Finance via Meu Pluggy (opcional) ---
# Deixe vazio para usar só o registro manual. Veja o passo a passo no README.
# Credenciais da aplicação em https://dashboard.pluggy.ai e itemId de cada banco
# conectado (separados por vírgula). Trate o secret como senha.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_ITEM_IDS=
# A cada quantas horas sincronizar (o Meu Pluggy atualiza os dados ~1x por dia)
SYNC_INTERVAL_HOURS=6
# Quantos dias para trás buscar a cada sincronização (máx. 365; é idempotente)
SYNC_LOOKBACK_DAYS=60
