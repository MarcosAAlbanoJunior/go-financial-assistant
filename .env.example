# Instalação nova: rode `make init` (preenche APP_SECRET_KEY_FILE e SETUP_TOKEN abaixo), depois `docker compose up -d`
# e abra http://localhost:8080. O setup no navegador define a senha do dashboard e liga o Telegram; o resto fica na
# página Configurações. Aqui só fica o que não pode sair do ambiente.

# --- Obrigatório ---

# Chave mestra (mínimo 16 caracteres) que cifra os segredos guardados no banco (token do bot, chaves de API). Nunca vai
# para o banco; se perdê-la, os segredos salvos precisam ser digitados de novo. `make init` (ou `make secret-key`) cria
# ./secrets/app_secret_key com permissão 600 e preenche a linha abaixo.
APP_SECRET_KEY_FILE=
# Alternativa mais simples (a chave fica no ambiente do container): gere com `openssl rand -base64 32`.
# APP_SECRET_KEY=

# Libera o setup pelo navegador (mínimo 24 caracteres; `make init` gera um com `openssl rand -hex 16`). Você cola este
# valor na primeira tela. Depois do setup, pode apagar (ou deixar: ele não abre mais nada).
SETUP_TOKEN=
# Recuperação: true reabre o setup (com o mesmo SETUP_TOKEN) para trocar a senha e/ou o canal, mantendo os dados.
# Reinicie o app depois de ligar e remova quando terminar.
# SETUP_REOPEN=true

# --- Infraestrutura ---

# Banco usado pelo `make run` (no Docker Compose o app já aponta para o container do Postgres).
DATABASE_URL=postgres://finassist:finassist@localhost:5432/finassist?sslmode=disable
PORT=3000
# Porta do dashboard no host (padrão 8080); o container só escuta em 127.0.0.1.
# WEB_PORT=8080

# Segundo fator: com o canal configurado, o login pede também um código enviado ao chat. off desliga (saída de
# emergência se você perder o acesso ao chat).
DASHBOARD_2FA=auto

# Containers extras do Docker Compose: deixe vazio.
COMPOSE_PROFILES=

# Backup do banco para ./backups (serviço "backup" do compose): intervalo em horas, quantos guardar e o usuário do host
# dono dos arquivos (rode `id -u` e `id -g`; o padrão é 1000:1000).
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14
# BACKUP_UID=1000
# BACKUP_GID=1000

# --- Opcional: tudo abaixo também se configura no dashboard (Configurações), e o que for salvo lá vale mais ---

# Senha do dashboard pelo .env (mínimo de 12 caracteres), no lugar da definida no setup.
# DASHBOARD_PASSWORD=

# Telegram pelo .env, no lugar do setup: token do @BotFather e o seu ID numérico.
# CHANNEL=telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# IA (Google Gemini). Sem a chave, o chat funciona com os comandos (/saldos, /resumo, /sync) e o dashboard inteiro;
# o que precisa de IA (mensagens livres, recibos, extratos, Coach) avisa como ligar.
# GEMINI_API_KEY=
# Coach: envia valores e nomes de estabelecimentos ao Gemini. No plano gratuito o Google pode usar e revisar o
# conteúdo; só use true se o projeto da chave tiver faturamento (serviços pagos).
# GEMINI_PAID_PLAN=false
# COACH_GEMINI_MODEL=

# Resumo semanal no chat (calculado por código, sem IA): dia (monday..sunday), hora (0-23) e fuso.
# DIGEST_ENABLED=true
# DIGEST_WEEKDAY=monday
# DIGEST_HOUR=9
# DIGEST_TIMEZONE=America/Sao_Paulo

# Open Finance via Meu Pluggy (veja o passo a passo no README). As três juntas, ou nenhuma.
# PLUGGY_CLIENT_ID=
# PLUGGY_CLIENT_SECRET=
# PLUGGY_ITEM_IDS=
# SYNC_INTERVAL_HOURS=6
# SYNC_LOOKBACK_DAYS=60

# Seus nomes como aparecem nos Pix e transferências do banco (separados por vírgula): Pix entre contas suas não é
# gasto nem renda. Ex.: MARIA DA SILVA
# OWN_NAMES=
