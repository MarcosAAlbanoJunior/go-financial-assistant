# Aplicação Go
PORT=3000
DATABASE_URL=postgres://finassist:finassist@localhost:5432/finassist?sslmode=disable
GEMINI_API_KEY=sua-chave-aqui
# Coach (tela com IA): envia valores e nomes de estabelecimentos ao Gemini. No plano gratuito o Google pode usar
# e revisar o conteúdo; só use true se o projeto da chave tiver faturamento (serviços pagos). Padrão: false (bloqueado).
# GEMINI_PAID_PLAN=false
# COACH_GEMINI_MODEL=

# Resumo semanal no canal de conversa (calculado por código, sem IA): contas novas, cobranças duplicadas,
# cobrança que voltou depois de cancelada e metas em risco. Dia (monday..sunday), hora (0-23) e fuso.
# DIGEST_ENABLED=true
# DIGEST_WEEKDAY=monday
# DIGEST_HOUR=9
# DIGEST_TIMEZONE=America/Sao_Paulo

# Backup do banco para ./backups (serviço "backup" do compose): intervalo em horas, quantos guardar e o usuário do host
# dono dos arquivos (rode `id -u` e `id -g`; o padrão é 1000:1000).
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14
# BACKUP_UID=1000
# BACKUP_GID=1000
ADMIN_SECRET=troque-por-uma-senha-forte

# Porta do dashboard no host (padrão 8080); o container só escuta em 127.0.0.1.
# WEB_PORT=8080

# Senha do dashboard (API /api). Mínimo de 12 caracteres. Vazia, a API fica desligada.
DASHBOARD_PASSWORD=
# Segundo fator: com o canal no ar, o login pede também um código enviado ao chat. off desliga (ex.: perdeu o acesso ao chat).
DASHBOARD_2FA=auto

# Canal de conversa: whatsapp (padrão) ou telegram
CHANNEL=whatsapp

# Quais containers o Docker Compose sobe: "whatsapp" inclui Evolution API + Redis.
# Para Telegram deixe vazio (COMPOSE_PROFILES=).
COMPOSE_PROFILES=whatsapp

# --- CHANNEL=whatsapp ---
ALLOWED_NUMBERS=12345678912345
EVOLUTION_API_KEY=sua-chave-evolution-aqui
EVOLUTION_API_URL=http://localhost:8082
EVOLUTION_INSTANCE=Financial Assistant
OWNER_PHONE=5511999999999

# --- CHANNEL=telegram ---
# Token criado no @BotFather e o seu ID numérico (descubra no @userinfobot).
# Só o usuário com esse ID é atendido.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Open Finance via Meu Pluggy (opcional) ---
# Deixe vazio para usar só o registro manual. Veja o passo a passo no README.
# Credenciais da aplicação em https://dashboard.pluggy.ai e itemId de cada banco
# conectado (separados por vírgula). Trate o secret como senha.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_ITEM_IDS=
# A cada quantas horas sincronizar (o Meu Pluggy atualiza os dados ~1x por dia)
SYNC_INTERVAL_HOURS=6
# Quantos dias para trás buscar a cada sincronização (máx. 365; é idempotente)
SYNC_LOOKBACK_DAYS=60

# Chave mestra (mínimo 16 caracteres) que cifra os segredos salvos pela página Configurações do dashboard
# (tokens, chaves de API). Nunca vai para o banco; se perdê-la, os segredos salvos precisam ser digitados de novo.
# Melhor forma: um arquivo. Rode `make secret-key` (cria ./secrets/app_secret_key com permissão 600) e use:
# APP_SECRET_KEY_FILE=/run/secrets/app_secret_key
# Alternativa mais simples (a chave fica no ambiente do container): gere com `openssl rand -base64 32`.
APP_SECRET_KEY_FILE=
APP_SECRET_KEY=

# Seus nomes como aparecem nos Pix e transferências do banco (separados por vírgula). Pix entre contas
# suas não é gasto nem renda e é ignorado. Ex.: MARIA DA SILVA
OWN_NAMES=
